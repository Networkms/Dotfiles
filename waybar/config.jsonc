{
  "layer": "top",
  "position": "top",
  "height": 48,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "modules-left": [
    "custom/fedora",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/roman-clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth",
    "custom/notifications",
    "tray",
    "custom/clipboard",
    "custom/btop",
    "custom/power"
  ],

  "custom/fedora": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Fedora Linux · App launcher",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "active-only": false,
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X",
      "11": "XI",
      "12": "XII",
      "13": "XIII",
      "14": "XIV",
      "15": "XV",
      "16": "XVI",
      "17": "XVII",
      "18": "XVIII",
      "19": "XIX",
      "20": "XX",
      "default": "5"
    },
    "persistent-workspaces": {
	    "*": 5
    },
    "all-outputs": true,
    "disable-scroll": true,
    "on-click": "activate"
  
  },

  "custom/roman-clock": {
    "exec": "python3 $HOME/.config/waybar/scripts/roman-clock.py",
    "return-type": "json",
    "interval": 1,
    "format": "󰥔  {}",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "󰏲",
        "portable": "󰏲",
        "car": "󰄋",
        "default": [
            "󰕿",
            "󰖀",
            "󰕾"
        ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": true,
    "tooltip-format": "{desc}\nVolume: {volume}%"
},

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{status}",
    "on-click": "blueman-manager"
  },

  "custom/notifications": {
    "format": "󰂚",
    "tooltip": true,
    "tooltip-format": "Notifications",
    "on-click": "swaync-client -t"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  },

  "custom/clipboard": {
    "format": "󰅍",
    "tooltip": true,
    "tooltip-format": "Clipboard history",
    "on-click": "sh -c 'cliphist list | rofi -dmenu -p Clipboard | cliphist decode | wl-copy'"
  },

  "custom/btop": {
    "format": "󰍛",
    "tooltip": true,
    "tooltip-format": "Open btop",
    "on-click": "ghostty -e btop"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Power menu",
    "on-click": "wlogout"
  }
}
